# Copy to .env and fill in. Never commit .env.
# Quote values that contain "&" (Neon URLs do), so shell scripts can source this file.

# Neon Postgres (Singapore). Pooled connection for the app:
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection for migrations and bulk loads (Vercel names it DATABASE_URL_UNPOOLED):
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# NASA FIRMS API key (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Vercel CLI token (only needed for manual deploys; CI uses a GitHub secret)
VERCEL_TOKEN=

# Base URL of the detection tiles (GitHub Release in production; local folder in dev/CI)
TILES_BASE_URL=file://./data/tiles
