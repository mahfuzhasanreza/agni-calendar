# Copy to .env and fill in. Never commit .env.
# Quote values that contain "&" (Neon URLs do), so shell scripts can source this file.

# Local dev database (pnpm db:up). Pooled-style URL used by the app:
DATABASE_URL="postgresql://agni:agni@localhost:5434/agni"
# Direct (unpooled) connection for migrations and bulk loads (Vercel names it DATABASE_URL_UNPOOLED):
DIRECT_URL="postgresql://agni:agni@localhost:5434/agni"

# NASA FIRMS API key (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Vercel CLI token (only needed for manual deploys; CI uses a GitHub secret)
VERCEL_TOKEN=

# Base URL of the detection tiles (production default: the Vercel Blob store; local folder in dev/CI)
TILES_BASE_URL=file://./data/tiles

# Production Neon URLs (Singapore). Only used explicitly, e.g. for production data loads.
NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
NEON_DIRECT_URL="postgresql://USER:PASSWORD@HOST.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob read-write token (only to upload tiles: node --env-file=.env scripts/upload-tiles.mjs)
BLOB_READ_WRITE_TOKEN=
